---
import Layout from '../layouts/Layout.astro';
import Workbench from '../components/Workbench';
import DemoVideo from '../components/DemoVideo.astro';
import ProjectDialogs from '../components/ProjectDialogs.astro';
import { profile, career, projects, experiments, books } from '../data/content';
---
<Layout title="Aleem Siddique — Engineering, imagination & motion" description="Product Development Engineer at AMD. A cinematic collection of Aleem Siddique’s engineering, interactive projects and fiction.">
  <section id="workbench" class="chapter hero-chapter" data-workbench data-scroll-chapter="hero" aria-label="Introduction and three-world creative journey">
    <div class="chapter-pin hero">
      <div class="workbench-stage"><Workbench client:visible /></div>
      <div class="hero-copy wrap">
        <p class="hero-role">Aleem Siddique / Product Development Engineer at AMD</p>
        <h1>Engineering.<br />Imagination.</h1>
        <p class="hero-intro">I bring silicon into the world, build things you can play with, and write worlds you can get lost in.</p>
        <div class="hero-phases">
          <p data-hero-phase="lens"><strong>Precision in motion.</strong>A mechanism becomes a creative tool. <a href="/work/icm-buddy/" data-project-open="icm-buddy">Discover ICM Buddy</a></p>
          <p data-hero-phase="circuit" hidden><strong>Ideas brought to life.</strong>From silicon bring-up to AI in your browser. <a href="#experience">Meet the engineer</a></p>
          <p data-hero-phase="book" hidden><strong>Worlds worth entering.</strong>Another kind of building, one word at a time. <a href="#writing">Explore the stories</a></p>
        </div>
        <div class="hero-actions"><a class="button button-primary" href="#work">Explore my work</a><a class="text-link" href="#experience">Experience</a></div>
      </div>
      <div class="hero-base wrap">
        <div class="scene-selector" aria-label="Choose a world"><button data-workbench-select="lens" aria-pressed="true">Lens</button><button data-workbench-select="circuit" aria-pressed="false">Circuit</button><button data-workbench-select="book" aria-pressed="false">Book</button></div>
        <p class="scene-caption" aria-live="polite"><span data-focus-caption="lens">Mechanisms &amp; movement</span><span data-focus-caption="circuit" hidden>Silicon &amp; systems</span><span data-focus-caption="book" hidden>Stories &amp; imagined worlds</span></p>
        <span class="scroll-hint" aria-hidden="true">Scroll to discover <span>↓</span></span>
      </div>
      <div class="chapter-meter" aria-hidden="true"></div>
    </div>
  </section>
  <section id="experience" class="chapter career-chapter" data-scroll-chapter="career" aria-labelledby="experience-title">
    <div class="chapter-pin wrap career-layout">
      <div class="career-heading"><p class="section-label">The day job</p><h2 id="experience-title">Making<br />silicon<br />work.</h2><p class="section-deck">Good engineering lives in the details, and in the trade-offs you find a way through.</p>
        <svg class="silicon-emblem" viewBox="0 0 320 320" aria-hidden="true"><g fill="none" stroke="currentColor"><rect x="76" y="76" width="168" height="168" rx="5"/><rect x="104" y="104" width="112" height="112" rx="2"/><path d="M126 126h68v68h-68Z M138 138h44v44h-44Z"/>{Array.from({length:8},(_,i)=><g><path d={'M'+(94+i*19)+' 48v28 M'+(94+i*19)+' 244v28'}/><path d={'M48 '+(94+i*19)+'h28 M244 '+(94+i*19)+'h28'}/></g>)}</g></svg>
      </div>
      <div class="career-story"><div class="career-role"><span class="amd-mark">AMD <svg width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 3h14v14h-5V8H3Zm0 8h6v6H3Z" fill="currentColor"/></svg></span><div><h3>{career.role}</h3><p>{career.dates}</p></div></div>
        <article class="career-beat is-active" data-career-beat="0"><h3>From bring-up to production.</h3><p>{career.summary}</p><ul class="product-list" aria-label="Products contributed to">{career.products.map(product=><li>{product}</li>)}</ul></article>
        <article class="career-beat" data-career-beat="1"><h3>Quality and yield. Together.</h3><p>Quality and yield can pull in opposite directions. My team and I worked to improve both together, challenging that trade-off through careful product development.</p></article>
        <article class="career-beat recognition" data-career-beat="2"><div class="award-number">2<span>nd</span></div><div><p class="award-year">Asia Technological Showcase / {career.recognition.year}</p><h3>An idea worth sharing.</h3><p>{career.recognition.detail}</p></div></article>
      </div>
    </div>
  </section>
  <section id="work" class="chapter projects-chapter" data-scroll-chapter="projects" aria-labelledby="work-title">
    <div class="chapter-pin projects-pin">
      <div class="projects-heading wrap"><div><p class="section-label">Independent work</p><h2 id="work-title">Ideas you can experience.</h2></div><p class="section-deck">Working prototypes, learning systems and interactive worlds.</p></div>
      <nav class="project-jumps wrap" aria-label="Jump to a featured project">{projects.map(project=><a href={'#stage-'+project.slug} data-project-jump={project.slug}><img src={project.logo} alt="" width="25" height="25"/><span>{project.title}</span></a>)}</nav>
      <div class="project-viewport"><div class="project-track">
        {projects.map((project,index)=><article id={'stage-'+project.slug} class="project-stage" data-project-stage={project.slug} data-active={index===0 ? 'true':'false'} style={'--project-accent:'+project.accent} aria-labelledby={'project-title-'+project.slug}>
          <div class="project-copy"><div class="project-identity"><img src={project.logo} alt="" width="88" height="88" loading="lazy"/><div><p class="project-category">{project.category}</p><p class="project-year">{project.year}</p></div></div>
            <h3 id={'project-title-'+project.slug}>{project.title}</h3><p class="project-purpose">{project.summary}</p>
            <dl class="project-facts"><div><dt>My contribution</dt><dd>{project.contribution}</dd></div><div><dt>Outcome</dt><dd>{project.outcome}</dd></div></dl>
            <div class="project-actions"><a class="button button-primary" href={'/work/'+project.slug+'/'} data-project-open={project.slug}>Explore details</a><a class="text-link" href={project.links[0].href}>{project.links[0].label}</a></div>
          </div>
          <figure class="project-demo">{project.media ? <DemoVideo mp4={project.media.mp4} webm={project.media.webm} poster={project.media.poster} label={project.title+' demonstration'}/> : <img src={project.image} alt={project.alt} width="1366" height="768" loading="lazy" decoding="async"/>}<figcaption>{project.media?.caption ?? project.alt}</figcaption></figure>
        </article>)}
      </div></div>
      <div class="project-position wrap" aria-live="polite"><span data-project-position>ICM Buddy</span><span aria-hidden="true">Scroll through the collection</span></div>
    </div>
  </section>
  <section id="writing" class="chapter writing-chapter" data-scroll-chapter="writing" aria-labelledby="writing-title">
    <div class="chapter-pin wrap writing-pin">
      <div class="section-top"><div><p class="section-label">Away from the circuit board</p><h2 id="writing-title">Worlds made<br />of words.</h2></div><div class="writing-intro"><p>Fiction about identity, relationships and imagined worlds, from contemporary Singapore stories to speculative thrillers and fantasy.</p><a class="text-link" href="/novel/">Open the full library</a></div></div>
      <div class="book-grid">{books.map((book,index)=><article class="book-card" style={'--book-index:'+index+';--fan-turn:'+(index-1)*10+'deg;--fan-shift:'+(1-index)*100+'px'}><a class="book-cover" href={book.href} tabindex="-1" aria-hidden="true"><img src={book.image} alt="" width="640" height="960" loading="lazy" decoding="async"/></a><div class="book-copy"><p class="book-genre">{book.genre}</p><h3><a href={book.href}>{book.title}</a></h3><p>{book.description}</p><a class="text-link" href={book.href} aria-label={'Read '+book.title}>Read the story</a></div></article>)}</div>
    </div>
  </section>
  <section id="experiments" class="chapter experiments-chapter" data-scroll-chapter="experiments" aria-labelledby="experiments-title">
    <div class="chapter-pin wrap experiments-pin"><div class="section-top"><div><p class="section-label">The playground</p><h2 id="experiments-title">Follow a different idea.</h2></div><p class="section-deck">Six small worlds. Each has a personality of its own.</p></div>
      <div class="experiment-grid">{experiments.map((experiment,index)=><article class="experiment-tile" style={'--project-accent:'+experiment.accent+';--mark-turn:'+(index%2 ? -10:10)+'deg;--mark-rise:'+(index%3)*18+'px'}><a href={experiment.href} data-project-open={experiment.slug} class="experiment-mark" tabindex="-1" aria-hidden="true"><img src={experiment.logo} alt="" width="112" height="112" loading="lazy"/></a><div class="experiment-copy"><p class="project-category">{experiment.category}</p><h3><a href={experiment.href} data-project-open={experiment.slug}>{experiment.title}</a></h3><p>{experiment.description}</p><div class="experiment-actions"><a class="text-link" href={experiment.href} data-project-open={experiment.slug} aria-label={'Explore '+experiment.title}>Explore details</a><a class="source-link" href={experiment.code} target="_blank" rel="noopener noreferrer" aria-label={'View '+experiment.title+' source'}>Source</a></div></div></article>)}</div>
    </div>
  </section>
  <section class="about-section wrap section-pad" aria-labelledby="about-title"><div class="portrait-frame"><img src="/showcase-assets/media/portrait.webp" alt="Aleem Siddique" width="700" height="800" loading="lazy"/></div><div class="about-copy"><p class="section-label">A thread through it all</p><h2 id="about-title">Curiosity<br />came first.</h2><p>{profile.about}</p><p class="qualification">{profile.qualification}</p><a class="text-link" href={profile.linkedin} target="_blank" rel="noopener noreferrer">Connect on LinkedIn</a><details class="motion-study"><summary>Watch the workbench motion study</summary><DemoVideo mp4="/showcase-assets/media/workbench-render.mp4" webm="/showcase-assets/media/workbench-render.webm" poster="/showcase-assets/media/workbench-poster.webp" label="A motion study of the actual interactive 3D scene"/><p>Rendered from the interactive scene.</p><details><summary>See the studio interpretation</summary><DemoVideo mp4="/showcase-assets/media/workbench-film.mp4" webm="/showcase-assets/media/workbench-film.webm" poster="/showcase-assets/media/workbench-film-poster.webp" label="Studio interpretation of a lens, circuit and book" loop={false}/><p>Generated concept visualization.</p></details></details></div></section>
  <section id="contact" class="contact-section section-pad" aria-labelledby="contact-title"><div class="wrap contact-grid"><div><p class="section-label">Keep the conversation going</p><h2 id="contact-title">What are you<br />curious about?</h2></div><div class="contact-copy"><p>A project, a story, a question. I’m always interested in a thoughtful conversation.</p><a class="contact-email" href={'mailto:'+profile.email}>{profile.email}</a><div class="contact-links"><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a><a href="/novel/">Novel library</a></div></div></div></section>
  <ProjectDialogs />
</Layout>
