---
import Layout from '../layouts/Layout.astro';
import Workbench from '../components/Workbench';
import DemoVideo from '../components/DemoVideo.astro';
import ProjectDialogs from '../components/ProjectDialogs.astro';
import { profile, career, projects, experiments, books } from '../data/content';
import '../styles/cinema.css';
const marquee = ['Engineering', 'Imagination', 'Silicon', 'Motion', 'Stories', 'Play'];
const credits = [
  { role: 'Written & directed by', names: ['Aleem Siddique'] },
  { role: 'Day job', names: [career.role + ', AMD'] },
  { role: 'Featuring', names: projects.map(project => project.title) },
  { role: 'Stories', names: books.map(book => book.title) },
  { role: 'The playground', names: experiments.map(experiment => experiment.title) },
];
---
<Layout title="Aleem Siddique — Engineering, imagination & motion" description="Product Development Engineer at AMD. A cinematic collection of Aleem Siddique’s engineering, interactive projects and fiction.">
  <div class="intro-reel" data-intro-reel aria-hidden="true">
    <span class="intro-bar intro-bar-top"></span><span class="intro-bar intro-bar-bottom"></span>
    <div class="intro-credits"><p class="intro-kicker">A portfolio by</p><p class="intro-name">Aleem Siddique</p><p class="intro-tag">Engineering <span>·</span> Imagination <span>·</span> Motion</p></div>
    <span class="intro-flare"></span>
  </div>
  <script is:inline>
    (() => {
      const html = document.documentElement;
      let seen = false;
      try { seen = sessionStorage.getItem('cinema-intro') === 'seen'; sessionStorage.setItem('cinema-intro', 'seen'); } catch {}
      if (seen || html.dataset.motion !== 'on' || location.hash || scrollY > 0) return;
      html.dataset.intro = 'play';
      html.style.setProperty('--title-delay', '2.05s');
      const end = () => { if (html.dataset.intro === 'play') html.dataset.intro = 'done'; };
      setTimeout(end, 2900);
      ['wheel', 'keydown', 'pointerdown', 'touchstart'].forEach(type => addEventListener(type, end, { once: true, passive: true }));
    })();
  </script>
  <div class="cine-grain" aria-hidden="true"></div>
  <div class="cine-light" data-cine-light aria-hidden="true"></div>
  <div class="cine-hud" aria-hidden="true">
    <span class="hud-rec"><i></i>Rec</span>
    <span class="hud-scene" data-hud-scene>Sc. 01 · The opening</span>
    <span class="hud-track"><span class="hud-progress" data-hud-progress></span></span>
    <span class="hud-timecode" data-hud-timecode>00:00:00:00</span>
  </div>
  <section id="workbench" class="chapter hero-chapter" data-workbench data-scroll-chapter="hero" data-scene="Sc. 01 · The opening" aria-label="Introduction and three-world creative journey">
    <div class="chapter-pin hero">
      <div class="workbench-stage"><Workbench client:visible /></div>
      <div class="hero-grade" aria-hidden="true"></div>
      <span class="hero-letterbox hero-letterbox-top" aria-hidden="true"></span><span class="hero-letterbox hero-letterbox-bottom" aria-hidden="true"></span>
      <span class="hero-flare" aria-hidden="true"></span>
      <div class="hero-frame" aria-hidden="true"><span>Scene 01</span><span>EXT. The workbench · Night</span><span>24 fps · 2.39 : 1</span></div>
      <div class="hero-copy wrap">
        <p class="hero-role">Aleem Siddique / Product Development Engineer at AMD</p>
        <h1><span class="title-line"><span>Engineering.</span></span><br /><span class="title-line"><span>Imagination.</span></span></h1>
        <p class="hero-intro">I bring silicon into the world, build things you can play with, and write worlds you can get lost in.</p>
        <div class="hero-phases">
          <p data-hero-phase="lens"><strong>Precision in motion.</strong>A mechanism becomes a creative tool. <a href="/work/icm-buddy/" data-project-open="icm-buddy">Discover ICM Buddy</a></p>
          <p data-hero-phase="circuit" hidden><strong>Ideas brought to life.</strong>From silicon bring-up to AI in your browser. <a href="#experience">Meet the engineer</a></p>
          <p data-hero-phase="book" hidden><strong>Worlds worth entering.</strong>Another kind of building, one word at a time. <a href="#writing">Explore the stories</a></p>
        </div>
        <div class="hero-actions"><a class="button button-primary" href="#work">Explore my work</a><a class="text-link" href="#experience">Experience</a></div>
      </div>
      <div class="hero-base wrap">
        <div class="scene-selector" aria-label="Choose a world"><button data-workbench-select="lens" aria-pressed="true">Lens</button><button data-workbench-select="circuit" aria-pressed="false">Circuit</button><button data-workbench-select="book" aria-pressed="false">Book</button></div>
        <p class="scene-caption" aria-live="polite"><span data-focus-caption="lens">Mechanisms &amp; movement</span><span data-focus-caption="circuit" hidden>Silicon &amp; systems</span><span data-focus-caption="book" hidden>Stories &amp; imagined worlds</span></p>
        <span class="scroll-hint" aria-hidden="true">Scroll to discover <span>↓</span></span>
      </div>
      <div class="chapter-meter" aria-hidden="true"></div>
    </div>
  </section>
  <div class="cine-marquee" aria-hidden="true"><div class="marquee-track">{[0, 1].map(() => <span class="marquee-run">{marquee.map(word => <span>{word}<i>✦</i></span>)}</span>)}</div></div>
  <section id="experience" class="chapter career-chapter" data-scroll-chapter="career" data-scene="Sc. 02 · The day job" aria-labelledby="experience-title">
    <div class="chapter-pin wrap career-layout">
      <div class="career-heading"><p class="scene-slate" aria-hidden="true" data-reveal="line"><span>Scene 02</span>INT. The lab · Day</p><p class="section-label" data-reveal="line">The day job</p><h2 id="experience-title" data-reveal="title">Making<br />silicon<br />work.</h2><p class="section-deck" data-reveal>Good engineering lives in the details, and in the trade-offs you find a way through.</p>
        <svg class="silicon-emblem" viewBox="0 0 320 320" aria-hidden="true"><g fill="none" stroke="currentColor"><rect x="76" y="76" width="168" height="168" rx="5"/><rect x="104" y="104" width="112" height="112" rx="2"/><path d="M126 126h68v68h-68Z M138 138h44v44h-44Z"/>{Array.from({length:8},(_,i)=><g><path d={'M'+(94+i*19)+' 48v28 M'+(94+i*19)+' 244v28'}/><path d={'M48 '+(94+i*19)+'h28 M244 '+(94+i*19)+'h28'}/></g>)}</g></svg>
      </div>
      <div class="career-story" data-reveal><div class="career-role"><span class="amd-mark">AMD <svg width="22" height="22" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 3h14v14h-5V8H3Zm0 8h6v6H3Z" fill="currentColor"/></svg></span><div><h3>{career.role}</h3><p>{career.dates}</p></div></div>
        <article class="career-beat is-active" data-career-beat="0"><h3>From bring-up to production.</h3><p>{career.summary}</p><ul class="product-list" aria-label="Products contributed to">{career.products.map(product=><li>{product}</li>)}</ul></article>
        <article class="career-beat" data-career-beat="1"><h3>Quality and yield. Together.</h3><p>Quality and yield can pull in opposite directions. My team and I worked to improve both together, challenging that trade-off through careful product development.</p></article>
        <article class="career-beat recognition" data-career-beat="2"><div class="award-number">2<span>nd</span></div><div><p class="award-year">Asia Technological Showcase / {career.recognition.year}</p><h3>An idea worth sharing.</h3><p>{career.recognition.detail}</p></div></article>
      </div>
    </div>
  </section>
  <section id="work" class="chapter projects-chapter" data-scroll-chapter="projects" data-scene="Sc. 03 · The reel" aria-labelledby="work-title">
    <div class="chapter-pin projects-pin">
      <div class="projects-heading wrap"><div><p class="scene-slate" aria-hidden="true" data-reveal="line"><span>Scene 03</span>The reel · Independent work</p><p class="section-label" data-reveal="line">Independent work</p><h2 id="work-title" data-reveal="title">Ideas you can experience.</h2></div><p class="section-deck" data-reveal>Working prototypes, learning systems and interactive worlds.</p></div>
      <nav class="project-jumps wrap" aria-label="Jump to a featured project">{projects.map(project=><a href={'#stage-'+project.slug} data-project-jump={project.slug}><img src={project.logo} alt="" width="25" height="25"/><span>{project.title}</span></a>)}</nav>
      <div class="project-viewport"><span class="film-sprockets film-sprockets-top" aria-hidden="true"></span><span class="film-sprockets film-sprockets-bottom" aria-hidden="true"></span><div class="project-track">
        {projects.map((project,index)=><article id={'stage-'+project.slug} class="project-stage" data-project-stage={project.slug} data-active={index===0 ? 'true':'false'} style={'--project-accent:'+project.accent} aria-labelledby={'project-title-'+project.slug}>
          <div class="project-copy"><div class="project-identity"><img src={project.logo} alt="" width="88" height="88" loading="lazy"/><div><p class="project-category">{project.category}</p><p class="project-year">{project.year}</p></div></div>
            <h3 id={'project-title-'+project.slug}>{project.title}</h3><p class="project-purpose">{project.summary}</p>
            <dl class="project-facts"><div><dt>My contribution</dt><dd>{project.contribution}</dd></div><div><dt>Outcome</dt><dd>{project.outcome}</dd></div></dl>
            <div class="project-actions"><a class="button button-primary" href={'/work/'+project.slug+'/'} data-project-open={project.slug}>Explore details</a><a class="text-link" href={project.links[0].href}>{project.links[0].label}</a></div>
          </div>
          <figure class="project-demo"><span class="frame-tag" aria-hidden="true">{'Take ' + String(index + 1).padStart(2, '0')}</span>{project.media ? <DemoVideo mp4={project.media.mp4} webm={project.media.webm} poster={project.media.poster} label={project.title+' demonstration'}/> : <img src={project.image} alt={project.alt} width="1366" height="768" loading="lazy" decoding="async"/>}<figcaption>{project.media?.caption ?? project.alt}</figcaption></figure>
        </article>)}
      </div></div>
      <div class="project-position wrap" aria-live="polite"><span data-project-position>ICM Buddy</span><span aria-hidden="true">Scroll through the collection</span></div>
    </div>
  </section>
  <div class="cine-marquee cine-marquee-reverse" aria-hidden="true"><div class="marquee-track">{[0, 1].map(() => <span class="marquee-run">{['Now showing', 'Worlds made of words', 'Chapter by chapter', 'Read the story'].map(word => <span>{word}<i>✦</i></span>)}</span>)}</div></div>
  <section id="writing" class="chapter writing-chapter" data-scroll-chapter="writing" data-scene="Sc. 04 · The library" aria-labelledby="writing-title">
    <div class="chapter-pin wrap writing-pin">
      <div class="section-top"><div><p class="scene-slate" aria-hidden="true" data-reveal="line"><span>Scene 04</span>INT. The library · Late</p><p class="section-label" data-reveal="line">Away from the circuit board</p><h2 id="writing-title" data-reveal="title">Worlds made<br />of words.</h2></div><div class="writing-intro" data-reveal><p>Fiction about identity, relationships and imagined worlds, from contemporary Singapore stories to speculative thrillers and fantasy.</p><a class="text-link" href="/novel/">Open the full library</a></div></div>
      <div class="book-grid" data-reveal>{books.map((book,index)=><article class="book-card" style={'--book-index:'+index+';--fan-turn:'+(index-1)*10+'deg;--fan-shift:'+(1-index)*100+'px'}><a class="book-cover" href={book.href} tabindex="-1" aria-hidden="true"><img class="book-poster" data-tilt src={book.image} alt="" width="640" height="960" loading="lazy" decoding="async"/></a><div class="book-copy"><p class="book-genre">{book.genre}</p><h3><a href={book.href}>{book.title}</a></h3><p>{book.description}</p><a class="text-link" href={book.href} aria-label={'Read '+book.title}>Read the story</a></div></article>)}</div>
    </div>
  </section>
  <section id="experiments" class="chapter experiments-chapter" data-scroll-chapter="experiments" data-scene="Sc. 05 · The playground" aria-labelledby="experiments-title">
    <div class="chapter-pin wrap experiments-pin"><div class="section-top"><div><p class="scene-slate" aria-hidden="true" data-reveal="line"><span>Scene 05</span>EXT. The playground · Golden hour</p><p class="section-label" data-reveal="line">The playground</p><h2 id="experiments-title" data-reveal="title">Follow a different idea.</h2></div><p class="section-deck" data-reveal>Six small worlds. Each has a personality of its own.</p></div>
      <div class="experiment-grid" data-reveal>{experiments.map((experiment,index)=><article class="experiment-tile" data-spotlight style={'--project-accent:'+experiment.accent+';--mark-turn:'+(index%2 ? -10:10)+'deg;--mark-rise:'+(index%3)*18+'px'}><a href={experiment.href} data-project-open={experiment.slug} class="experiment-mark" tabindex="-1" aria-hidden="true"><img src={experiment.logo} alt="" width="112" height="112" loading="lazy"/></a><div class="experiment-copy"><p class="project-category">{experiment.category}</p><h3><a href={experiment.href} data-project-open={experiment.slug}>{experiment.title}</a></h3><p>{experiment.description}</p><div class="experiment-actions"><a class="text-link" href={experiment.href} data-project-open={experiment.slug} aria-label={'Explore '+experiment.title}>Explore details</a><a class="source-link" href={experiment.code} target="_blank" rel="noopener noreferrer" aria-label={'View '+experiment.title+' source'}>Source</a></div></div></article>)}</div>
    </div>
  </section>
  <section class="about-section wrap section-pad" data-scene="Sc. 06 · Close-up" aria-labelledby="about-title"><div class="portrait-frame" data-reveal="wipe"><img src="/showcase-assets/media/portrait.webp" alt="Aleem Siddique" width="700" height="800" loading="lazy"/></div><div class="about-copy"><p class="scene-slate" aria-hidden="true" data-reveal="line"><span>Scene 06</span>Close-up</p><p class="section-label" data-reveal="line">A thread through it all</p><h2 id="about-title" data-reveal="title">Curiosity<br />came first.</h2><p>{profile.about}</p><p class="qualification">{profile.qualification}</p><a class="text-link" href={profile.linkedin} target="_blank" rel="noopener noreferrer">Connect on LinkedIn</a><details class="motion-study"><summary>Watch the workbench motion study</summary><DemoVideo mp4="/showcase-assets/media/workbench-render.mp4" webm="/showcase-assets/media/workbench-render.webm" poster="/showcase-assets/media/workbench-poster.webp" label="A motion study of the actual interactive 3D scene"/><p>Rendered from the interactive scene.</p><details><summary>See the studio interpretation</summary><DemoVideo mp4="/showcase-assets/media/workbench-film.mp4" webm="/showcase-assets/media/workbench-film.webm" poster="/showcase-assets/media/workbench-film-poster.webp" label="Studio interpretation of a lens, circuit and book" loop={false}/><p>Generated concept visualization.</p></details></details></div></section>
  <section id="contact" class="contact-section section-pad" data-scene="End credits" aria-labelledby="contact-title"><div class="wrap contact-grid"><div><p class="scene-slate" aria-hidden="true" data-reveal="line"><span>End credits</span>Roll it</p><p class="section-label" data-reveal="line">Keep the conversation going</p><h2 id="contact-title" data-reveal="title">What are you<br />curious about?</h2></div><div class="contact-copy" data-reveal><p>A project, a story, a question. I’m always interested in a thoughtful conversation.</p><a class="contact-email" href={'mailto:'+profile.email}>{profile.email}</a><div class="contact-links"><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a><a href="/novel/">Novel library</a></div></div></div>
    <div class="credits-roll wrap">{credits.map(credit => <div class="credit" data-reveal><p class="credit-role">{credit.role}</p><ul>{credit.names.map(name => <li>{name}</li>)}</ul></div>)}</div>
    <p class="fin" aria-hidden="true" data-reveal="title">Fin.</p>
  </section>
  <ProjectDialogs />
  <script>
    import { initializeCinema } from '../scripts/cinema';
    initializeCinema();
  </script>
</Layout>
