---
import '../styles/global.css';
interface Props { title: string; description: string; image?: string }
const { title, description, image = '/showcase-assets/media/social-card.jpg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = Astro.url.pathname === '/';
const anchor = (id: string) => `${home ? '' : '/'}#${id}`;
---
<!doctype html>
<html lang="en" data-cinematic="off">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080b10" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const saved = localStorage.getItem('fieldbook-motion');
        document.documentElement.dataset.motion = saved === 'off' || (saved !== 'on' && matchMedia('(prefers-reduced-motion: reduce)').matches) ? 'off' : 'on';
      } catch { document.documentElement.dataset.motion = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'off' : 'on'; }
      document.documentElement.dataset.cinematic = document.documentElement.dataset.motion === 'on' && matchMedia('(min-width: 1024px) and (min-height: 700px) and (hover: hover) and (pointer: fine)').matches ? 'on' : 'off';
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Aleem Siddique, home">
        <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><path d="M16 2 28 9v14L16 30 4 23V9Z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m16 8 7 4v8l-7 4-7-4v-8Zm0 0v8m-7-4 7 4 7-4m-7 4v8" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
        <span>Aleem Siddique<span class="wordmark-note">Engineering &amp; imagination</span></span>
      </a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu <span aria-hidden="true">+</span></button>
      <nav id="site-nav" class="site-nav" aria-label="Main navigation">
        <a href={anchor('work')}>Work</a><a href={anchor('writing')}>Writing</a><a href={anchor('experience')}>Experience</a><a href={anchor('contact')}>Contact</a>
      </nav>
      <button class="motion-toggle" data-motion-toggle aria-pressed="false"><svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M4 5v10M9 5v10M14 5v10" fill="none" stroke="currentColor" stroke-width="1.5"/></svg><span>Pause motion</span></button>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <span>Aleem Siddique · Singapore</span>
      <a href="https://github.com/SeaBoiii/seaboiii.github.io" target="_blank" rel="noopener noreferrer">Built with curiosity. View the source.</a>
      <span>© {new Date().getFullYear()}</span>
    </footer>
    <script>
      import { initializeExperience } from '../scripts/experience';
      initializeExperience();
    </script>
  </body>
</html>
