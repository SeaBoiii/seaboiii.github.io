{
  "name": "aleem-fieldbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "assemble": "node scripts/assemble.mjs",
    "preview:site": "node scripts/serve.mjs",
    "preview:legacy": "node scripts/serve.mjs --legacy",
    "test:site": "node qa/site.mjs",
    "test:novels": "node ../web/qa/novels.mjs",
    "test:reader": "node ../web/qa/reader-state.mjs",
    "preview:novels": "node scripts/serve.mjs --port=4175",
    "media:workbench": "node scripts/render-workbench.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@fontsource/literata": "^5.2.0",
    "@react-three/fiber": "9.8.1",
    "astro": "7.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.10.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "ffmpeg-static": "^5.2.0",
    "playwright": "^1.56.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.2": true
  }
}
